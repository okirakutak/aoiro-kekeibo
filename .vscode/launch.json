{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Electron: Main Process (npm run dev)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/app",
            "console": "integratedTerminal",
            "autoAttachChildProcesses": true,
            "outFiles": [
                "${workspaceFolder}/app/dist-electron/**/*.js"
            ]
        }
    ]
}