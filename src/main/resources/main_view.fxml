<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="850.0" prefWidth="1280.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.aoiro.MainController">
   <!-- 左側サイドバー -->
   <left>
      <VBox prefWidth="220.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <!-- サイドバーヘッダー -->
            <VBox styleClass="sidebar-header">
               <children>
                  <Label styleClass="sidebar-title" text="青色申告 MVP" />
               </children>
            </VBox>
            <!-- メニューリスト -->
            <VBox spacing="4.0" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets top="16.0" />
               </padding>
               <children>
                  <Button fx:id="btnNavJournal" maxWidth="1.7976931348623157E308" onAction="#showJournalTab" styleClass="nav-button, active" text="📖 仕訳帳" />
                  <Button fx:id="btnNavLedger" maxWidth="1.7976931348623157E308" onAction="#showLedgerTab" styleClass="nav-button" text="📒 総勘定元帳" />
                  <Button fx:id="btnNavPL" maxWidth="1.7976931348623157E308" onAction="#showPLTab" styleClass="nav-button" text="📊 損益計算書 (PL)" />
                  <Button fx:id="btnNavBS" maxWidth="1.7976931348623157E308" onAction="#showBSTab" styleClass="nav-button" text="⚖️ 貸借対照表 (BS)" />
                  <Button fx:id="btnNavImport" maxWidth="1.7976931348623157E308" onAction="#showImportTab" styleClass="nav-button" text="📥 データインポート" />
                  <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="🏷️ 科目一括設定" />
                  <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="🔍 期末残高チェック" />
                  <Button maxWidth="1.7976931348623157E308" styleClass="nav-button" text="🔍 検証（やよい比較）" />
               </children>
            </VBox>
         </children>
      </VBox>
   </left>

   <!-- 中央メインコンテンツエリア -->
   <center>
      <VBox spacing="24.0" styleClass="main-content" BorderPane.alignment="CENTER">
         <children>
            <!-- ダッシュボードヘッダー -->
            <HBox alignment="CENTER_RIGHT" spacing="12.0">
               <children>
                  <Button fx:id="btnOpenExcel" onAction="#handleOpenExcel" styleClass="btn-primary" text="Open Excel File" />
                  <Button styleClass="btn-secondary" text="やよいインポート" />
               </children>
            </HBox>

            <!-- 中央パネルエリア (未読込 vs 仕訳帳 vs 総勘定元帳 vs PL vs BS) -->
            <StackPane VBox.vgrow="ALWAYS">
               <children>
                  <!-- 1. 未読込時表示パネル -->
                  <VBox fx:id="emptyCard" alignment="CENTER" spacing="16.0" styleClass="empty-card">
                     <children>
                        <Label styleClass="empty-card-title" text="データソースを選択してください" />
                        <Label styleClass="empty-card-desc" text="「Open Excel File」で自作Excelを読み込むか、&#10;「やよいインポート」でやよいの仕訳日記帳を読み込めます。" />
                     </children>
                  </VBox>

                  <!-- 2. 仕訳帳表示コンテナ -->
                  <VBox fx:id="journalContainer" spacing="16.0" visible="false">
                     <children>
                        <Label fx:id="lblJournalCount" styleClass="empty-card-title" text="仕訳帳 (0 件)" />
                        <TableView fx:id="journalTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colDate" prefWidth="110.0" text="日付" />
                              <TableColumn fx:id="colDebit" prefWidth="180.0" text="借方" />
                              <TableColumn fx:id="colCredit" prefWidth="180.0" text="貸方" />
                              <TableColumn fx:id="colAmount" prefWidth="120.0" text="金額" />
                              <TableColumn fx:id="colDescription" prefWidth="240.0" text="摘要" />
                              <TableColumn fx:id="colSourceSheet" prefWidth="120.0" text="元データ" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>

                  <!-- 3. 総勘定元帳表示コンテナ -->
                  <VBox fx:id="ledgerContainer" spacing="16.0" visible="false">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                           <children>
                              <Label styleClass="empty-card-title" text="総勘定元帳" />
                              <ComboBox fx:id="cmbLedgerAccount" onAction="#handleLedgerAccountChange" prefWidth="420.0" />
                           </children>
                        </HBox>
                        <TableView fx:id="ledgerTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colLedgerDate" prefWidth="110.0" text="日付" />
                              <TableColumn fx:id="colLedgerOpponent" prefWidth="220.0" text="相手勘定" />
                              <TableColumn fx:id="colLedgerDesc" prefWidth="260.0" text="摘要" />
                              <TableColumn fx:id="colLedgerDebit" prefWidth="130.0" text="借方" />
                              <TableColumn fx:id="colLedgerCredit" prefWidth="130.0" text="貸方" />
                              <TableColumn fx:id="colLedgerBalance" prefWidth="140.0" text="残高" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" spacing="24.0" styleClass="summary-panel">
                           <children>
                              <Label styleClass="summary-label" text="期末残高" />
                              <Label fx:id="lblLedgerTotalDebit" styleClass="summary-value" text="借方計: 0" />
                              <Label fx:id="lblLedgerTotalCredit" styleClass="summary-value" text="貸方計: 0" />
                              <Label fx:id="lblLedgerClosingBalance" styleClass="summary-value" text="最終残高: 0" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- 4. 損益計算書 (PL) 表示コンテナ -->
                  <VBox fx:id="plContainer" spacing="16.0" visible="false">
                     <children>
                        <Label styleClass="empty-card-title" text="損益計算書 (PL)" />
                        <HBox spacing="24.0" VBox.vgrow="ALWAYS">
                           <children>
                              <!-- 費用（借方） -->
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox styleClass="report-section-header">
                                       <children>
                                          <Label styleClass="report-section-title" text="費用（借方）" />
                                       </children>
                                    </VBox>
                                    <TableView fx:id="tblPLExpenses" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colPLExpenseName" prefWidth="250.0" text="勘定科目" />
                                          <TableColumn fx:id="colPLExpenseAmount" prefWidth="150.0" text="金額" />
                                       </columns>
                                       <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    </TableView>
                                    <HBox alignment="CENTER_RIGHT" styleClass="summary-panel">
                                       <children>
                                          <Label styleClass="summary-label" text="費用合計: " />
                                          <Label fx:id="lblPLTotalExpense" styleClass="summary-value" text="0" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- 収益（貸方） -->
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox styleClass="report-section-header">
                                       <children>
                                          <Label styleClass="report-section-title" text="収益（貸方）" />
                                       </children>
                                    </VBox>
                                    <TableView fx:id="tblPLRevenues" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colPLRevenueName" prefWidth="250.0" text="勘定科目" />
                                          <TableColumn fx:id="colPLRevenueAmount" prefWidth="150.0" text="金額" />
                                       </columns>
                                       <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    </TableView>
                                    <HBox alignment="CENTER_RIGHT" styleClass="summary-panel">
                                       <children>
                                          <Label styleClass="summary-label" text="収益合計: " />
                                          <Label fx:id="lblPLTotalRevenue" styleClass="summary-value" text="0" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- 5. 貸借対照表 (BS) 表示コンテナ -->
                  <VBox fx:id="bsContainer" spacing="16.0" visible="false">
                     <children>
                        <Label styleClass="empty-card-title" text="貸借対照表 (BS)" />
                        <HBox spacing="24.0" VBox.vgrow="ALWAYS">
                           <children>
                              <!-- 資産（借方） -->
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox styleClass="report-section-header">
                                       <children>
                                          <Label styleClass="report-section-title" text="資産（借方）" />
                                       </children>
                                    </VBox>
                                    <TableView fx:id="tblBSAssets" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colBSAssetName" prefWidth="250.0" text="勘定科目" />
                                          <TableColumn fx:id="colBSAssetAmount" prefWidth="150.0" text="金額" />
                                       </columns>
                                       <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    </TableView>
                                    <HBox alignment="CENTER_RIGHT" styleClass="summary-panel">
                                       <children>
                                          <Label styleClass="summary-label" text="資産合計: " />
                                          <Label fx:id="lblBSTotalAsset" styleClass="summary-value" text="0" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- 負債・資本（貸方） -->
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <VBox styleClass="report-section-header">
                                       <children>
                                          <Label styleClass="report-section-title" text="負債・資本（貸方）" />
                                       </children>
                                    </VBox>
                                    <TableView fx:id="tblBSLiabilities" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colBSLiabilityName" prefWidth="250.0" text="勘定科目" />
                                          <TableColumn fx:id="colBSLiabilityAmount" prefWidth="150.0" text="金額" />
                                       </columns>
                                       <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                    </TableView>
                                    <HBox alignment="CENTER_RIGHT" styleClass="summary-panel">
                                       <children>
                                          <Label styleClass="summary-label" text="負債・資本合計: " />
                                          <Label fx:id="lblBSTotalLiability" styleClass="summary-value" text="0" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- 6. データインポート表示コンテナ -->
                  <VBox fx:id="importContainer" spacing="16.0" visible="false">
                     <children>
                        <Label styleClass="empty-card-title" text="📥 データインポート" />
                        <HBox spacing="24.0" VBox.vgrow="ALWAYS">
                           <children>
                              <VBox spacing="8.0" prefWidth="300.0">
                                 <children>
                                    <Label styleClass="report-section-title" text="ワークシート" />
                                    <ListView fx:id="lstImportSheets" VBox.vgrow="ALWAYS" prefHeight="380.0" />
                                 </children>
                              </VBox>
                              <StackPane HBox.hgrow="ALWAYS">
                                 <children>
                                    <!-- ステップ1: 初期設定画面 (React版ImportPanel.tsxのstep='none'と同等) -->
                                    <VBox fx:id="importStepPane" spacing="16.0">
                                       <children>
                                          <Label styleClass="report-section-title" text="インポート設定" />
                                          <Label fx:id="lblImportInfo" styleClass="empty-card-desc" text="" wrapText="true" visible="false" />
                                          <VBox fx:id="importSetupCard" spacing="16.0" styleClass="summary-panel">
                                             <children>
                                                <Label fx:id="lblImportSheetName" styleClass="summary-label" text="" wrapText="true" />
                                                <Label fx:id="lblImportStatus" styleClass="text-success" text="" wrapText="true" />
                                                <Label fx:id="lblImportJsonDetail" alignment="TOP_LEFT" maxWidth="Infinity" styleClass="import-desc" text="" wrapText="true" />
                                                <Label fx:id="lblImportWarningDesc" alignment="TOP_LEFT" maxWidth="Infinity" styleClass="import-desc" text="" wrapText="true" visible="false" />
                                                <HBox fx:id="importFormatBox" spacing="24.0" visible="false">
                                                   <children>
                                                      <VBox spacing="8.0">
                                                         <children>
                                                            <Label styleClass="summary-label" text="ファイル形式" />
                                                            <RadioButton fx:id="rdoFormatHtml" selected="true" text="HTMLファイル (複数可)" />
                                                            <RadioButton fx:id="rdoFormatCsv" text="CSV / TSV (単一)" />
                                                         </children>
                                                      </VBox>
                                                      <VBox spacing="8.0">
                                                         <children>
                                                            <Label styleClass="summary-label" text="処理モード" />
                                                            <RadioButton fx:id="rdoModeJson" selected="true" text="インポート用JSONを生成 (永続化)" />
                                                            <RadioButton fx:id="rdoModeDirect" text="インポートデータを直接生成 (今回のみ)" />
                                                         </children>
                                                      </VBox>
                                                   </children>
                                                </HBox>
                                                <HBox spacing="12.0">
                                                   <children>
                                                      <Button fx:id="btnImportPreview" onAction="#handleImportPreview" styleClass="btn-primary" text="ファイルを選択してインポート (複数可)" visible="false" />
                                                      <Button fx:id="btnImportExtract" onAction="#handleImportExtract" styleClass="btn-primary" text="ファイルを選択してテキスト抽出" visible="false" />
                                                   </children>
                                                </HBox>
                                             </children>
                                          </VBox>
                                       </children>
                                    </VBox>
                                    <!-- ステップ2: AI出力貼り付け画面 -->
                                    <VBox fx:id="importPastePane" spacing="16.0" visible="false">
                                       <children>
                                          <Label styleClass="report-section-title" text="AIの出力結果を貼り付けてください" />
                                          <TextArea fx:id="txtImportAiInput" VBox.vgrow="ALWAYS" prefHeight="300.0" promptText="AIが生成したJSONまたはTSVを貼り付けてください" />
                                          <HBox spacing="12.0" alignment="CENTER_RIGHT">
                                             <children>
                                                <Button onAction="#handleImportCancel" styleClass="btn-secondary" text="キャンセル" />
                                                <Button onAction="#handleImportAiNext" styleClass="btn-primary" text="次へ (プレビュー)" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                    <!-- ステップ3: プレビュー画面 -->
                                    <VBox fx:id="importPreviewPane" spacing="16.0" visible="false">
                                       <children>
                                          <Label fx:id="lblImportPreviewCount" styleClass="report-section-title" text="インポートデータのプレビュー (0件)" />
                                          <TableView fx:id="tblImportPreview" VBox.vgrow="ALWAYS" prefHeight="300.0">
                                             <columns>
                                                <TableColumn fx:id="colImportDate" prefWidth="110.0" text="日付" />
                                                <TableColumn fx:id="colImportDesc" prefWidth="260.0" text="摘要" />
                                                <TableColumn fx:id="colImportAccount" prefWidth="160.0" text="勘定科目" />
                                                <TableColumn fx:id="colImportAmount" prefWidth="120.0" text="金額" />
                                             </columns>
                                             <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                          </TableView>
                                          <HBox spacing="12.0" alignment="CENTER_RIGHT">
                                             <children>
                                                <Button onAction="#handleImportCancel" styleClass="btn-secondary" text="キャンセル" />
                                                <Button onAction="#handleImportSave" styleClass="btn-primary" text="データを保存" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                 </children>
                              </StackPane>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </VBox>
   </center>
</BorderPane>
