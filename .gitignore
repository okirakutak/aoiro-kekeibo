# 依存関係パッケージ（大容量のためリポジトリから除外）
node_modules/

# ビルド成果物
dist/
dist-electron/

# エディタ・IDE・ツール設定フォルダ
.idea/
.vscode/
.obsidian/
.proxyai/

# ログファイル・一時ファイル
*.log
.DS_Store

# Gradle Kotlin ビルド成果物
build/
.gradle/

# 会計データ（個人情報を含むため追跡しない）
*.xlsx
*.xls

