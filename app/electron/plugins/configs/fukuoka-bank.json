    "description": {
      "index": 1
    },
    "income": {
      "index": 3
    },
    "expense": {
      "index": 2
    },
    "balance": {
      "index": 4
    }
  },
  "targetSheet": "福岡銀行",
  "defaultDebitAccount": "普通預金",
  "defaultDebitSubAccount": "福岡銀行",
  "defaultCreditAccount": "普通預金",
  "defaultCreditSubAccount": "福岡銀行",
  "mappingRules": [
    {
      "keyword": "住宅",
      "debitAccount": "地代家賃"
    },
    {
      "keyword": "カード",
      "debitAccount": "事業主借"
    }
  ],
  "hasOpeningBalance": true
}