    "description": {
      "index": 1
    },
    "expense": {
      "index": 2
    },
    "income": {
      "index": 3
    },
    "balance": {
      "index": 4
    }
  },
  "targetSheet": "住信SBI銀行",
  "defaultDebitAccount": "普通預金",
  "defaultDebitSubAccount": "住信SBI銀行",
  "defaultCreditAccount": "普通預金",
  "defaultCreditSubAccount": "住信SBI銀行",
  "mappingRules": [
    {
      "keyword": "振込",
      "debitAccount": "事業主借"
    },
    {
      "keyword": "ATM",
      "debitAccount": "事業主借"
    }
  ],
  "hasOpeningBalance": true
